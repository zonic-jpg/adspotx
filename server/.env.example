# AdSpot api-server — environment
#
# After `pnpm --filter @workspace/db run seed:accounts`, owner super admin:
#   oadeagbo@gmail.com / password123  (login at /brands/login — see STAGING_GUIDANCE.md)
PORT=3001
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/adspot
JWT_SECRET=change-me-to-a-long-random-string

# OpenAI integration (optional — AI features lazy-load; server boots without valid keys)
# Preferred names (AdSpot integration):
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# Standard fallbacks also supported:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Serve the built frontend from this same server (unified single-origin deploy)
STATIC_DIR=./app/dist
# Optional: object storage for ad media uploads
# PUBLIC_OBJECT_SEARCH_PATHS=bucket/ads

# CORS: same-origin by default (this server serves the SPA). To allow external
# origins (e.g. a separately hosted frontend), set a comma-separated allowlist:
# CORS_ORIGINS=https://app.adspot.ng,https://staging.adspot.ng

# SPLIT-ORIGIN DEPLOYS (frontend hosted separately from this API):
# 1) Build the app with:  VITE_API_BASE_URL=https://api.yourdomain.com pnpm build
# 2) Set here:            CORS_ORIGINS=https://your-frontend-domain.com
# One-server deploys (pnpm start) need neither.
