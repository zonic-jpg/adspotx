# AdSpotX — copy to .env (gitignored). Never commit real values.

# ── Supabase (required for Phase 2) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: owner notify when ADMINTESTER requests approval
# VITE_ZONIC_NOTIFY_URL=

# ── Deploy (Netlify) ──
GITHUB_REPO=zonic-jpg/adspotx
GITHUB_BRANCH=main
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_BUILD_HOOK=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ── Legacy (Express — deprecated, do not use for Netlify SPA) ──
# DATABASE_URL=postgres://...
# JWT_SECRET=
# VITE_API_BASE_URL=  # REMOVED — do not set
